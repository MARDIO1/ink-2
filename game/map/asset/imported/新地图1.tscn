[node name="DialogueTrigger" type="Node2D" parent="DialogueTriggers" unique_id=1397227784]
position = Vector2(-123.16576, 154.66238)
script = ExtResource("28_ixonj")
lines = PackedStringArray("为了找到白色死神的真相，墨水人向着流星的方向前进！", "远处的其它人好像有点不对劲......")
editor_id = "dialogue_1"

[node name="DialogueTrigger2" type="Node2D" parent="DialogueTriggers" unique_id=2104727546]
position = Vector2(236.0426, 154.64668)
script = ExtResource("28_ixonj")
lines = PackedStringArray("“啊，救我，救我......”", "是被白色死神沾染的墨水生物，只会无意识地挥动肢体攻击，好可怜......", "毫不留情地终结它吧！这也是没办法的事。", "墨水人最好画把武器......不过他其实空手也能击败怪物！")
editor_id = "dialogue_2"

[node name="DialogueTrigger3" type="Node2D" parent="DialogueTriggers" unique_id=14057575]
position = Vector2(905.9795, 63.46396)
script = ExtResource("28_ixonj")
lines = PackedStringArray("墨水人想到，那些怪物应该也挺怕摔。")
editor_id = "dialogue_3"

