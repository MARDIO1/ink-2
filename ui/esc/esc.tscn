[gd_scene load_steps=5 format=3]

[ext_resource type="Texture2D" path="res://ui/esc/asset/icon_play.svg" id="1_play"]
[ext_resource type="Texture2D" path="res://ui/esc/asset/exit.tres" id="2_exit"]
[ext_resource type="Theme" path="res://ui/theme/asset/ink_attack_theme.tres" id="3_theme"]
[ext_resource type="Script" path="res://ui/esc/src/esc.gd" id="4_script"]

[node name="Esc" type="CanvasLayer"]
process_mode = 3
layer = 20
script = ExtResource("4_script")

[node name="Dim" type="ColorRect" parent="."]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0.0352941, 0.0313726, 0.0235294, 0.62)

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("3_theme")

[node name="Panel" type="PanelContainer" parent="Center"]
custom_minimum_size = Vector2(360, 0)
layout_mode = 2
theme_type_variation = &"OverlayPanel"

[node name="Buttons" type="VBoxContainer" parent="Center/Panel"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="Title" type="Label" parent="Center/Panel/Buttons"]
layout_mode = 2
theme_type_variation = &"TitleLabel"
text = "INK ATTACK"
horizontal_alignment = 1

[node name="ContinueButton" type="Button" parent="Center/Panel/Buttons"]
custom_minimum_size = Vector2(0, 54)
layout_mode = 2
theme_type_variation = &"PrimaryButton"
mouse_default_cursor_shape = 2
text = "继续"
icon = ExtResource("1_play")
expand_icon = true

[node name="MenuButton" type="Button" parent="Center/Panel/Buttons"]
custom_minimum_size = Vector2(0, 54)
layout_mode = 2
mouse_default_cursor_shape = 2
text = "回主菜单"

[node name="QuitButton" type="Button" parent="Center/Panel/Buttons"]
custom_minimum_size = Vector2(0, 54)
layout_mode = 2
theme_type_variation = &"DangerButton"
mouse_default_cursor_shape = 2
text = "退出"
icon = ExtResource("2_exit")
expand_icon = true

[connection signal="pressed" from="Center/Panel/Buttons/ContinueButton" to="." method="_on_continue_button_pressed"]
[connection signal="pressed" from="Center/Panel/Buttons/MenuButton" to="." method="_on_menu_button_pressed"]
[connection signal="pressed" from="Center/Panel/Buttons/QuitButton" to="." method="_on_quit_button_pressed"]
