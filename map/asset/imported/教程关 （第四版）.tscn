[node name="DialogueTrigger2" type="Node2D" parent="DialogueTriggers" unique_id=256004853]
position = Vector2(766.0371, 168.61272)
script = ExtResource("26_gjr25")
lines = PackedStringArray("坡可以跳过去，对于高的坡，则可以翻过去。", "不知道怎么攀爬？按下Q切换至攀爬模式！", "这个模式在攀爬时十分方便......可以在这个模式下抓住固定物体，然后翻过去！")
editor_id = "dialogue_2"

[node name="DialogueTrigger3" type="Node2D" parent="DialogueTriggers" unique_id=1727600429]
position = Vector2(1222.2396, 178.70746)
script = ExtResource("26_gjr25")
lines = PackedStringArray("又是一道门......冒险故事总会有很多门！", "周围没有画布，幸好墨水人在附近发现了现成的武器！", "如果抓不起来，看看是不是忘关攀爬模式了。")
editor_id = "dialogue_3"

[node name="DialogueTrigger" type="Node2D" parent="DialogueTriggers" unique_id=1943610011]
position = Vector2(561.6548, 168.46143)
script = ExtResource("26_gjr25")
lines = PackedStringArray("墨水人遇到了一道门？砸碎它，别问为什么！", "嗯......墨水人好像空手砸不开？于是它决定画一个东西砸开它！", "墨水人看到了那块画布，并用旁边的工具画点武器砸碎它，工具很简单，就和画图软件中的一样！", "墨水人觉得，最好画一个尖头的工具......", "他画好后按E实体化了工具！！")
editor_id = "dialogue_1"

