[node name="DialogueTriggers" type="Node2D" parent="." unique_id=207149715]

[node name="DialogueTrigger2" type="Node2D" parent="DialogueTriggers" unique_id=256004853]
visible = false
position = Vector2(766.0371, 168.61272)
script = ExtResource("28_uji6n")
lines = PackedStringArray("坡可以跳过去，对于高的坡，则可以翻过去。", "不知道怎么攀爬？按下Q切换至攀爬模式！", "这个模式在攀爬时十分方便......可以在这个模式下抓住固定物体，然后翻过去！")
editor_id = "dialogue_2"

[node name="DialogueTrigger3" type="Node2D" parent="DialogueTriggers" unique_id=1727600429]
visible = false
position = Vector2(1222.2396, 178.70746)
script = ExtResource("28_uji6n")
lines = PackedStringArray("又是一道门......冒险故事总会有很多门！", "周围没有画布，幸好墨水人在附近发现了现成的武器！", "如果抓不起来，看看是不是忘关攀爬模式了。")
editor_id = "dialogue_3"

[node name="DialogueTrigger" type="Node2D" parent="DialogueTriggers" unique_id=1943610011]
visible = false
position = Vector2(561.6548, 168.46143)
script = ExtResource("28_uji6n")
lines = PackedStringArray("墨水人遇到了一道门？砸碎它，别问为什么！", "嗯......墨水人好像空手砸不开？于是它决定画一个东西砸开它！", "墨水人看到了那块画布，并用旁边的工具画点武器砸碎它，工具很简单，就和画图软件中的一样！", "墨水人觉得，最好画一个尖头的工具......", "他画好后按E实体化了工具！！")
editor_id = "dialogue_1"

[node name="DialogueTrigger4" type="Node2D" parent="DialogueTriggers" unique_id=1138197103]
visible = false
position = Vector2(-473.93323, 160.80054)
script = ExtResource("28_uji6n")
lines = PackedStringArray("墨水人从纸上醒来。", "墨水人看起来睡了很久，幸好他还记得怎么动！A,D左右移动，空格跳跃。", "他睡得太久了，手有点麻！他想举点什么东西来活动一下。", "（把手拖到物体上，然后长按就可以抓住物体了！）", "墨水人也知道，有些东西抓不动：它们被钉死了。")
editor_id = "dialogue_4"

[node name="DialogueTrigger5" type="Node2D" parent="DialogueTriggers" unique_id=443786285]
visible = false
position = Vector2(-151.19713, 193.87599)
script = ExtResource("28_uji6n")
lines = PackedStringArray("墨水人力气不如别人......但是它会画画！", "这里正好就有块画布！", "他太久没用画布了，所以认认真真地看了看画布有哪些功能。", "画画也要适量，因为墨水人作画用的是自己的墨水！")
editor_id = "dialogue_5"

[node name="DialogueTrigger6" type="Node2D" parent="DialogueTriggers" unique_id=991327810]
visible = false
position = Vector2(1374.4237, 190.71718)
script = ExtResource("28_uji6n")
lines = PackedStringArray("前面没路了.......不过有个纸洞！", "穿过纸洞就可以去下一页了！", "墨水人决定去下一页冒险！")
editor_id = "dialogue_6"

