[node name="DialogueTriggers" type="Node2D" parent="." unique_id=207149715]

[node name="DialogueTrigger" type="Node2D" parent="DialogueTriggers" unique_id=959767687]
position = Vector2(-249.90707, 630.009)
script = ExtResource("24_i6ii2")
lines = PackedStringArray("墨水人从纸上醒来。", "墨水人看起来睡了很久，幸好他还记得怎么动！A,D左右移动，空格跳跃。", "他睡得太久了，手有点麻！他想举点什么东西来活动一下。（把手拖到物体上，然后长按就可以抓住物体了！）", "墨水人也知道，有些东西抓不动：它们被钉死了。")
editor_id = "dialogue_1"

[node name="DialogueTrigger3" type="Node2D" parent="DialogueTriggers" unique_id=1739352606]
position = Vector2(156.01, 629.8645)
script = ExtResource("24_i6ii2")
lines = PackedStringArray("墨水人拥有独特的能力，那就是画画！", "而面前正好有一块画布！", "对于一个画家，最重要的就是使用绘画工具，从最基础的画笔绘制，与图形绘制开始......", "画画会消耗墨水人的墨水，磕碰也会，墨水耗尽时，墨水人就去世了......", "使用橡皮擦擦除多余的部分，使用清理画布功能一键重绘，被擦除的部分则会回到墨水瓶内。", "在画好后，使用固化功能（e）将画好的东西实体化。", "可惜，实体化后就无法收回，不过失误后可以通过菜单进行重绘画布（也就是快速重开！）。")
editor_id = "dialogue_3"

[node name="DialogueTrigger4" type="Node2D" parent="DialogueTriggers" unique_id=1919369253]
position = Vector2(508.80508, 629.247)
script = ExtResource("24_i6ii2")
lines = PackedStringArray("墨水人被藤蔓挡住了......现在正是画画的时候。", "墨水人空手砸不开？于是它决定画一个东西砸开它！", "墨水人觉得，最好画一个尖头的工具......")
editor_id = "dialogue_4"

[node name="DialogueTrigger5" type="Node2D" parent="DialogueTriggers" unique_id=1893674454]
position = Vector2(917.33167, 744.3513)
script = ExtResource("24_i6ii2")
lines = PackedStringArray("墨水人可以通过跳跃越过很多障碍，可惜掉下来的时候会很痛......", "这时候墨水人就会改变手的抓握方式，进入利于攀爬的形态！（按下Q）", "在这个形态下，墨水人抓不动东西，却得到了无与伦比的攀爬能力。", "爬上高坡，或是在硬着陆前抓住地面以避免衰落伤害！", "需要抓住东西时，就可以关闭攀爬模式。（再按一次Q！）")
editor_id = "dialogue_5"

[node name="DialogueTrigger2" type="Node2D" parent="DialogueTriggers" unique_id=1681235666]
position = Vector2(1565.8276, 747.9346)
script = ExtResource("24_i6ii2")
lines = PackedStringArray("白色流星！墨水人头一次见到这种颜色的流星。", "不过它们的落点好像墨水人的家附近，而这些白色物体看起来非常危险......", "该回家去看看了。")
editor_id = "dialogue_2"

[node name="DialogueTrigger6" type="Node2D" parent="DialogueTriggers" unique_id=1069094460]
position = Vector2(2070.433, 600.5762)
script = ExtResource("24_i6ii2")
lines = PackedStringArray("靠近喷泉时，喷涌的墨水让墨水人焕然一新！", "看来就算墨水人再次倒下，也会回到喷泉旁边。", "如果画布恰好在喷泉旁边，就可以随意绘画了！", "前面正好有个断口，可以画出一道桥。", "......不过该怎么固定住往下掉的物体呢？")
editor_id = "dialogue_6"

[node name="DialogueTrigger7" type="Node2D" parent="DialogueTriggers" unique_id=129064470]
position = Vector2(2634.2046, 593.6178)
script = ExtResource("24_i6ii2")
lines = PackedStringArray("前面没路了.......不过有个纸洞！", "墨水人知道，那里通往自己的家。")
editor_id = "dialogue_7"

