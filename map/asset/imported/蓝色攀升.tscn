theme_override_fonts/font = ExtResource("25_itidf")
theme_override_font_sizes/font_size = 48
text = "停稳后向左落台 ←"
script = ExtResource("26_2p8ic")
editor_id = "blue_ascent_18"

[node name="MachineNote_Turn" type="Label" parent="MapTexts" unique_id=1104067673 groups=["map_text_label"]]
z_index = 20
offset_left = 320.0
offset_top = 780.0
offset_right = 321.0
offset_bottom = 803.0
scale = Vector2(0.375, 0.375)
theme_override_colors/font_color = Color(0.14117648, 0.14117648, 0.14117648, 1)
theme_override_fonts/font = ExtResource("25_itidf")
theme_override_font_sizes/font_size = 48
text = "从长坡顶端向左上短跳，落到左上黑台；
沿左上方黑坡和两块短台阶前进，
再向右上方短跳，返回第⑥段桥前。"
script = ExtResource("26_2p8ic")
editor_id = "blue_ascent_20"

[node name="MachineNote_FinaleDrive" type="Label" parent="MapTexts" unique_id=481421924 groups=["map_text_label"]]
z_index = 20
offset_left = 613.8751
offset_top = 304.375
offset_right = 2053.875
offset_bottom = 473.375
scale = Vector2(0.39166665, 0.39166665)
theme_override_colors/font_color = Color(0.035, 0.031, 0.024, 1)
theme_override_colors/font_shadow_color = Color(1, 1, 1, 0)
theme_override_fonts/font = ExtResource("25_itidf")
theme_override_font_sizes/font_size = 48
text = "蓝墨·画笔 15px：在齿轮左侧，补齐红墨与黄轴之间的蓝线缺口。
蓝线沿黄轴向齿轮供电；黑轮左侧的向上箭头带动齿轮、提起闸门。
门停稳后，从桥面下方通过。"
script = ExtResource("26_2p8ic")
editor_id = "blue_ascent_note_finale_drive"

[node name="MapText" type="Label" parent="MapTexts" unique_id=576283631 groups=["map_text_label"]]
z_index = 20
offset_left = 425.875
offset_top = 2084.125
offset_right = 1481.875
offset_bottom = 2461.125
scale = Vector2(0.35, 0.35)
theme_override_colors/font_color = Color(0.035, 0.031, 0.024, 1)
theme_override_colors/font_shadow_color = Color(1, 1, 1, 0)
theme_override_fonts/font = ExtResource("25_itidf")
theme_override_font_sizes/font_size = 48
text = "③ 先走到平桥中段；切蓝墨·画笔 7px。
找到右侧下悬黑臂底部、红墨右边的两段蓝线。
竖着补齐蓝线缺口，再按「固化」。
等桥向右上方抬起，沿桥上行，从右端短跳上岸。"
script = ExtResource("26_2p8ic")
editor_id = "blue_ascent_12"

[node name="MapText2" type="Label" parent="MapTexts" unique_id=1526708558 groups=["map_text_label"]]
z_index = 20
