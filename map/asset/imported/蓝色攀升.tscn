[node name="MachineNote_Gate" type="Label" parent="MapTexts" unique_id=2006794131 groups=["map_text_label"]]
z_index = 20
offset_left = 90.0
offset_top = 3465.0
offset_right = 91.0
offset_bottom = 3488.0
scale = Vector2(0.375, 0.375)
theme_override_colors/font_color = Color(0.14117648, 0.14117648, 0.14117648, 1)
theme_override_fonts/font = ExtResource("25_itidf")
theme_override_font_sizes/font_size = 48
text = "① 蓝墨·画笔 7px
连接门底横向蓝线的缺口，再按「固化」。
等门升起，从门下向右通过，沿黑坡上层。"
script = ExtResource("26_2p8ic")
editor_id = "blue_ascent_9"

[node name="MachineNote_Bridge" type="Label" parent="MapTexts" unique_id=1888762259 groups=["map_text_label"]]
z_index = 20
offset_left = 1306.8749
offset_top = 2662.125
offset_right = 2410.875
offset_bottom = 3039.125
scale = Vector2(0.375, 0.375)
theme_override_colors/font_color = Color(0.14117648, 0.14117648, 0.14117648, 1)
theme_override_fonts/font = ExtResource("25_itidf")
theme_override_font_sizes/font_size = 48
text = "② 蓝墨·形状→矩形 7px
从红墨左侧短蓝线起笔，沿黑色横条向左拖。
箭头朝左，再按「固化」；动力会拉断黄墨保险簧。
等桥伸到左岸，向左过桥，再沿黑坡向上走。"
script = ExtResource("26_2p8ic")
editor_id = "blue_ascent_11"

[node name="MachineNote_Crates" type="Label" parent="MapTexts" unique_id=178318881 groups=["map_text_label"]]
z_index = 20
offset_left = 1424.375
offset_top = 1471.375
offset_right = 2614.375
offset_bottom = 1968.375
scale = Vector2(0.375, 0.375)
theme_override_colors/font_color = Color(0.14117648, 0.14117648, 0.14117648, 1)
theme_override_fonts/font = ExtResource("25_itidf")
theme_override_font_sizes/font_size = 48
text = "④ 黄墨·画笔 12px：连接两箱相邻的黑色安装座，固化。
切蓝墨·形状→矩形 7–12px。
从高箱红墨左侧短蓝线，沿黑色横条向左拖出箭头。
再按「固化」，等高箱牵引矮箱一起向左停靠。
从右侧跳上矮箱，再跳上高箱，最后向左上岸。"
script = ExtResource("26_2p8ic")
editor_id = "blue_ascent_13"

[node name="MachineNote_Lift" type="Label" parent="MapTexts" unique_id=76586463 groups=["map_text_label"]]
z_index = 20
offset_left = 1625.6316
offset_top = 983.25
offset_right = 2796.6316
offset_bottom = 1583.25
scale = Vector2(0.39166665, 0.39166665)
theme_override_colors/font_color = Color(0.14117648, 0.14117648, 0.14117648, 1)
theme_override_fonts/font = ExtResource("25_itidf")
theme_override_font_sizes/font_size = 48
text = "⑤ 双黄杆与配重摆渡台
从左侧台阶落到黄杆，沿黄杆缓坡走上右侧黑色踏台。
蓝墨·形状→矩形 12px：从黑臂底部红墨旁的蓝点起笔，
沿黑臂竖直向上画箭头，再按「固化」。
双黄杆保持踏台水平，左端配重辅助向左上摆升。
等停稳后向左落到接落台，沿黑坡向左上行。"
script = ExtResource("26_2p8ic")
editor_id = "blue_ascent_16"

[node name="MachineNote_LaunchExit" type="Label" parent="MapTexts" unique_id=1877950259 groups=["map_text_label"]]
z_index = 20
offset_left = 1179.625
offset_top = 959.25
offset_right = 1582.625
offset_bottom = 1023.25
scale = Vector2(0.49166664, 0.49166664)
