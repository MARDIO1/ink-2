theme_override_font_sizes/font_size = 19
text = "第三页 · 动力登顶
先搭乘升降台，再接通山顶齿轮。
途中绘制空心台阶，绕过灰色崖面。
两盏灯亮后，山顶纸洞解锁。"
script = ExtResource("22_r5jp3")

