[node name="DialogueTriggers" type="Node2D" parent="." unique_id=311883970]

[node name="Opening" type="Node2D" parent="DialogueTriggers" unique_id=1740918772]
position = Vector2(340, 350)
script = ExtResource("21_dialogue")
lines = PackedStringArray("真倒霉，是吧？我是小墨瓶，平常专门给墨水人帮忙。", "刚才那是白色死神。它会把碰到的东西慢慢融掉，沾上的墨水人也会发疯。", "比如前面那个。先别跟它讲道理——它看起来已经把道理忘光了。")
editor_id = "second-opening"

[node name="Civilian" type="Node2D" parent="DialogueTriggers" unique_id=149793900]
position = Vector2(1030, 350)
script = ExtResource("21_dialogue")
lines = PackedStringArray("救、救我……那场白雨把我的身体擦掉了一块。我不想变成它们……", "你再说下去，血条就要替你说完了。我们得先处理挡路的家伙。", "空手可不够。看到旁边的画布了吗？画一件趁手的武器吧。", "画完按 E 固化。只有变成实体，墨水才能握在手里。")
editor_id = "second-civilian"

[node name="FountainHint" type="Node2D" parent="DialogueTriggers" unique_id=191209348]
position = Vector2(1550, 350)
script = ExtResource("21_dialogue")
lines = PackedStringArray("墨水就是生命。前面那座墨泉能把消耗补回来。", "靠近它，瓶子会自己装满。以后你也可以围着泉边画点喜欢的东西。")
editor_id = "second-fountain-hint"

[node name="Ending" type="Node2D" parent="DialogueTriggers" unique_id=916347590]
position = Vector2(2050, 350)
script = ExtResource("21_dialogue")
lines = PackedStringArray("白雨不是天气，它像是在找什么。", "下一页，我们得找到雨落下来的地方。")
editor_id = "second-ending"

